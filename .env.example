# Open-Meteo (free, no API key required — leave blank)
# https://open-meteo.com/
REACT_APP_OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# ENTSO-E Transparency Platform (electricity spot prices)
# Register at: https://transparency.entsoe.eu/usrm/user/createPublicUser
REACT_APP_ENTSOE_API_KEY=your_entsoe_api_key_here

# Google Calendar API
# Create credentials at: https://console.cloud.google.com/
REACT_APP_GOOGLE_CLIENT_ID=your_google_client_id_here
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here
